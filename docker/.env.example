# ============================================================
# Environment Variables Template
# Copy to .env and fill in your values
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=health_clinics
POSTGRES_USER=health_clinics
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8080
JWT_SECRET=healthClinicsSecretKeyForJWT2025VeryLongSecretKey
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- AI Service ----
AI_SERVICE_PORT=8000
GROQ_API_KEY=
LANGCHAIN_API_KEY=
MODEL_TYPE=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=120
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=nt118-chatbot

# ---- Frontend ----
FRONTEND_PORT=80

# ---- Azure Container Registry (for CI/CD) ----
ACR_LOGIN_SERVER=
ACR_USERNAME=
ACR_PASSWORD=
